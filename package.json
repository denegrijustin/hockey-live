{
  "name": "hockey-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "refresh:data": "node scripts/refresh-data.mjs",
    "test": "node --test tests/model.test.mjs",
    "test:browser": "playwright test",
    "dev:worker": "wrangler dev --port 8788",
    "deploy": "pnpm build && wrangler deploy",
    "refresh:edge": "node scripts/refresh-edge.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "^4.141.0"
  }
}
