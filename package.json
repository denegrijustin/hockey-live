{
  "name": "iceboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "refresh:data": "node scripts/refresh-data.mjs && node scripts/refresh-matchups.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "dev:worker": "wrangler dev --port 8788",
    "deploy": "pnpm build && wrangler deploy",
    "refresh:edge": "node scripts/refresh-edge.mjs",
    "refresh:matchups": "node scripts/refresh-matchups.mjs",
    "refresh:moneypuck": "node scripts/refresh-moneypuck.mjs"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "d3-geo": "^3.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "6.1.1",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "7.0.2",
    "us-atlas": "^3.0.1",
    "vite": "8.3.1",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.141.0"
  }
}
