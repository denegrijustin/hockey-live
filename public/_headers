/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://assets.nhle.com https://a.espncdn.com data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=0, must-revalidate
/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/data/games/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/data/moneypuck/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=86400
